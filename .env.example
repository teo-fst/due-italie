# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo lato server (route cron). MAI con prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Vercel Cron invia "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=una-stringa-lunga-e-casuale

# R10: il gioco parte quando gli iscritti con un'Italia scelta raggiungono questa soglia
SOGLIA_AVVIO=1000

# R7: se true, la route cron si ferma finché ci sono proposte senza fonti verificate
STRICT_SOURCES=false

# URL pubblico (per i link delle email di accesso)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
