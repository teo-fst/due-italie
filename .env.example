# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo lato server. MAI con prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Chiave segreta per l'hash dei giocatori (HMAC-SHA256), almeno 32 caratteri casuali:
#   openssl rand -hex 32
# Se cambia, tutti i giocatori perdono l'accesso ai propri dati: conservarla con cura.
PLAYER_HASH_PEPPER=

# R7: se true, non si possono avviare partite finché le proposte non sono verificate da una persona
STRICT_SOURCES=false
